<?xml version="1.0" encoding="UTF-8"?>
<!-- Argus Database State template (chained HTTP Ingestion -> Database State).
     Fires the HTTP trigger (creates the order w/ correlation.id), waits for the async
     insert, then runs the scenario's VERIFY query (db.query, correlation filled by the
     runner) via JDBC and EVALUATES the scenario's EXPECT (FINDING-7): column==value,
     row_count, and a negative zero-row mode — not just "result contains correlation_id".
     Judged by the JMeter success flag (content layer). JDBC driver + postgresql jar are in
     acme-jmeter. db.url/db.user/db.password from argus-config targets.database (read-only). -->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Argus: Database State" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="database-state ${__P(scenario.id,unknown)}" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(load.users,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(load.ramp,0)}</stringProp>
        <stringProp name="ThreadGroup.scheduler">${__P(load.scheduler,false)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(load.duration,0)}</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(load.loops,1)}</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="orders-db" enabled="true">
          <stringProp name="dataSource">ordersPool</stringProp>
          <stringProp name="dbUrl">${__P(db.url,)}</stringProp>
          <stringProp name="driver">org.postgresql.Driver</stringProp>
          <stringProp name="username">${__P(db.user,)}</stringProp>
          <stringProp name="password">${__P(db.password,)}</stringProp>
          <!-- ONE connection: this plan runs ONE query. JMeter opens the whole pool up front
               (DataSourceElement.initPool: setInitialSize(poolMax)), so poolMax 5 needed 5
               connections for one SELECT. A read-only role with a connection limit below 5 then
               refused the pool (a hosted dev cluster, a read-only role with rolconnlimit 3, one run:
               "FATAL: too many connections for role"). Same as cleanup-sql.jmx.
               Default 1; a load run with load.users > 1 can raise it with -Jdb.pool.max=N. -->

          <stringProp name="poolMax">${__P(db.pool.max,1)}</stringProp>
          <stringProp name="timeout">10000</stringProp>
          <stringProp name="connectionAge">5000</stringProp>
          <stringProp name="trimInterval">60000</stringProp>
          <boolProp name="autocommit">true</boolProp>
          <boolProp name="keepAlive">true</boolProp>
          <boolProp name="preinit">false</boolProp>
          <stringProp name="transactionIsolation">DEFAULT</stringProp>
          <stringProp name="checkQuery"></stringProp>
          <stringProp name="connectionProperties"></stringProp>
          <stringProp name="initQuery"></stringProp>
        </JDBCDataSource>
        <hashTree/>

        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
            <elementProp name="" elementType="Header"><stringProp name="Header.name">X-Correlation-Id</stringProp><stringProp name="Header.value">${__P(correlation.id,)}</stringProp></elementProp>
            <elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${__P(auth.header,)}</stringProp></elementProp>
            <elementProp name="" elementType="Header"><stringProp name="Header.name">Idempotency-Key</stringProp><stringProp name="Header.value">${__P(idempotency.key,)}</stringProp></elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="${__P(scenario.id,unknown)}-trigger" enabled="true">
          <stringProp name="HTTPSampler.connect_timeout">${__P(trigger.timeout_ms,)}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${__P(trigger.timeout_ms,)}</stringProp>
          <stringProp name="HTTPSampler.domain">${__P(http.host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(http.port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(http.protocol,http)}</stringProp>
          <stringProp name="HTTPSampler.path">${__P(trigger.path,/)}</stringProp>
          <stringProp name="HTTPSampler.method">${__P(trigger.method,POST)}</stringProp>
          <stringProp name="HTTPSampler.use_keepalive">${__P(http.keepalive,false)}</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${__P(trigger.payload,{})}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="apply author headers (VR12-T3)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">// VR12-T3 (V29-018): apply EVERY header the scenario's author declared in its ## TRIGGER.
// The runner sets trigger.header_n and, per header i, trigger.header_i_name / _value.
//
// Until 0.3.31 the parser populated every declared header and the runner sent exactly ONE of
// them (Authorization). SYN-MCP-002 and SYN-MCP-004 each declare
// `Accept: application/json, text/event-stream` and neither ever sent it.
//
// An author header REPLACES the runner's for the same name — hence the remove-then-add. A
// scenario that declares none leaves this block a no-op, so its bytes on the wire are IDENTICAL
// to before this template changed.
//
// VR12-X10: header NAMES may be logged, values NEVER.
def n = 0
try { n = Integer.parseInt(props.get("trigger.header_n") ?: "0") } catch (e) { n = 0 }
if (n &gt; 0) {
  def hm = sampler.getHeaderManager()
  if (hm == null) {
    hm = new org.apache.jmeter.protocol.http.control.HeaderManager()
    hm.setName("author headers")
    hm.setProperty(org.apache.jmeter.testelement.TestElement.TEST_CLASS, "HeaderManager")
    hm.setProperty(org.apache.jmeter.testelement.TestElement.GUI_CLASS, "HeaderPanel")
    sampler.setHeaderManager(hm)
  }
  for (int i = 1; i &lt;= n; i++) {
    def name = props.get("trigger.header_" + i + "_name")
    if (name == null || name.trim().isEmpty()) { continue }
    def value = props.get("trigger.header_" + i + "_value") ?: ""
    hm.removeHeaderNamed(name)
    hm.add(new org.apache.jmeter.protocol.http.control.Header(name, value))
  }
}</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="trigger is stimulus-only (DF-14)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// DF-14: the trigger is a STIMULUS, not the verdict. A negative content test (trigger
// expected to be REJECTED, e.g. qty:0 -&gt; 400, then assert 0 rows) must be judged ONLY by
// the verify assertion below — so mark the trigger sample successful regardless of HTTP
// status, recording the actual code for reference. A positive test still fails correctly:
// if the trigger should have persisted a row and didn't, the verify JSR223 fails.
def code = prev.getResponseCode()
prev.setSuccessful(true)
prev.setResponseMessage("trigger status " + code + " (decoupled — content verdict = verify assertion only, DF-14)")</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>


        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="second request only when status2= is declared (AC-D30)" enabled="true">
          <!-- AC-D30 (#171): the SECOND request of a declared `status2=` - the same order, re-sent under the same
               Idempotency-Key (the HeaderManager above is thread-group scope, so it covers both samplers).
               DeriveProps sets trigger.second ONLY when status2= is declared, so a scenario without it runs
               exactly as before. The JDBC verify below runs after BOTH requests, so a row check is judged
               on the real double submit. http-idempotency.jmx has no JDBC sampler, which is why the fix is
               here and not a switch to that template. -->
          <stringProp name="IfController.condition">${__P(trigger.second,false)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="${__P(scenario.id,unknown)}-trigger2" enabled="true">
            <stringProp name="HTTPSampler.connect_timeout">${__P(trigger.timeout_ms,)}</stringProp>
            <stringProp name="HTTPSampler.response_timeout">${__P(trigger.timeout_ms,)}</stringProp>
            <stringProp name="HTTPSampler.domain">${__P(http.host,localhost)}</stringProp>
            <stringProp name="HTTPSampler.port">${__P(http.port,8080)}</stringProp>
            <stringProp name="HTTPSampler.protocol">${__P(http.protocol,http)}</stringProp>
            <stringProp name="HTTPSampler.path">${__P(trigger.path,/)}</stringProp>
            <stringProp name="HTTPSampler.method">${__P(trigger.method,POST)}</stringProp>
            <stringProp name="HTTPSampler.use_keepalive">${__P(http.keepalive,false)}</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${__P(trigger.payload,{})}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="apply author headers (VR12-T3)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">// VR12-T3 (V29-018): apply EVERY header the scenario's author declared in its ## TRIGGER.
// The runner sets trigger.header_n and, per header i, trigger.header_i_name / _value.
//
// Until 0.3.31 the parser populated every declared header and the runner sent exactly ONE of
// them (Authorization). SYN-MCP-002 and SYN-MCP-004 each declare
// `Accept: application/json, text/event-stream` and neither ever sent it.
//
// An author header REPLACES the runner's for the same name — hence the remove-then-add. A
// scenario that declares none leaves this block a no-op, so its bytes on the wire are IDENTICAL
// to before this template changed.
//
// VR12-X10: header NAMES may be logged, values NEVER.
def n = 0
try { n = Integer.parseInt(props.get("trigger.header_n") ?: "0") } catch (e) { n = 0 }
if (n &gt; 0) {
  def hm = sampler.getHeaderManager()
  if (hm == null) {
    hm = new org.apache.jmeter.protocol.http.control.HeaderManager()
    hm.setName("author headers")
    hm.setProperty(org.apache.jmeter.testelement.TestElement.TEST_CLASS, "HeaderManager")
    hm.setProperty(org.apache.jmeter.testelement.TestElement.GUI_CLASS, "HeaderPanel")
    sampler.setHeaderManager(hm)
  }
  for (int i = 1; i &lt;= n; i++) {
    def name = props.get("trigger.header_" + i + "_name")
    if (name == null || name.trim().isEmpty()) { continue }
    def value = props.get("trigger.header_" + i + "_value") ?: ""
    hm.removeHeaderNamed(name)
    hm.add(new org.apache.jmeter.protocol.http.control.Header(name, value))
  }
}</stringProp>
          </JSR223PreProcessor>
          <hashTree/>

            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="trigger is stimulus-only (DF-14)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// DF-14: the trigger is a STIMULUS, not the verdict. A negative content test (trigger
// expected to be REJECTED, e.g. qty:0 -&gt; 400, then assert 0 rows) must be judged ONLY by
// the verify assertion below — so mark the trigger sample successful regardless of HTTP
// status, recording the actual code for reference. A positive test still fails correctly:
// if the trigger should have persisted a row and didn't, the verify JSR223 fails.
def code = prev.getResponseCode()
prev.setSuccessful(true)
prev.setResponseMessage("trigger status " + code + " (decoupled — content verdict = verify assertion only, DF-14)")</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="${__P(scenario.id,unknown)}-verify" enabled="true">
          <stringProp name="dataSource">ordersPool</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <!-- RO-09/CONFLICT-1 (argus-owned, in-repo): the default must NOT be the bare
               `SELECT 1` tautology (1 row regardless of state → false green). `SELECT 1 WHERE 1=0`
               returns ZERO rows, so a scenario that reaches a run with no real VERIFY query fails
               loudly (row_count==1 → red) instead of passing tautologically. The durable gate is
               validate_scenario, which now rejects a prose-only Database State VERIFY upstream. -->
          <stringProp name="query">${__P(db.query,SELECT 1 WHERE 1=0)}</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout">${__P(trigger.timeout_s,)}</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="wait for async insert" enabled="true">
            <stringProp name="ConstantTimer.delay">${__P(db.settle.ms,2500)}</stringProp>
          </ConstantTimer>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="evaluate EXPECT (FINDING-7)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
// FINDING-7: evaluate the scenario's EXPECT against the JDBC result, not just "result
// contains correlation_id". JMeter JDBC "Store as String" renders the result as
// tab-separated columns with a HEADER row first, newline-separated rows:
//   "order_id\tstatus\tcorrelation_id\n &lt;v1&gt;\t&lt;v2&gt;\t&lt;v3&gt;\n ..."
// Empty result = header line only. Failure messages are reality-only (name the ACTUAL
// result, never the test's expected value — VR-C8).
def body = (prev.getResponseDataAsString() ?: "")
def hasRows = (props.get("expect.has_rows") ?: "true").toString()
def rowCountP = (props.get("expect.row_count") ?: "").toString()
def columnsP = (props.get("expect.columns") ?: "").toString()
def corr = (props.get("correlation.id") ?: "").toString()

def fail = { String m -&gt; prev.setSuccessful(false); prev.setResponseMessage(m) }

// The query must have RUN before its result means anything. When JDBC fails (no connection,
// refused login, a permission or syntax error) the sampler is already unsuccessful, its code is
// "&lt;SQLState&gt; &lt;errorCode&gt;" and its BODY is the exception text: one line, no header. Read as a
// result set that is "no rows", and the message was overwritten with "query returned no rows",
// which reported a refused connection as an empty table. Say what happened instead.
if (!prev.isSuccessful()) {
  def why = (prev.getResponseMessage() ?: "").toString().replaceAll("[\\r\\n]+", " ")
  if (why.length() &gt; 300) { why = why.substring(0, 300) + "..." }
  fail("database query did not run (" + prev.getResponseCode() + "): " + why)
  return
}

def lines = body.split("\n").findAll { it.trim().length() &gt; 0 }
def header = lines ? (lines[0].split("\t") as List) : []
int dataRows = lines.size() &gt; 0 ? lines.size() - 1 : 0
def colVals = { String name -&gt;
  int idx = header.findIndexOf { it.trim().equalsIgnoreCase(name) }
  if (idx &lt; 0) return null
  def vals = []
  for (int i = 1; i &lt; lines.size(); i++) {
    def cells = lines[i].split("\t")
    vals.add(idx &lt; cells.length ? cells[idx].trim() : "")
  }
  return vals
}

if (hasRows == "false") {
  if (dataRows != 0) { fail("query returned " + dataRows + " row(s) for correlation_id " + corr) }
  return
}
if (dataRows == 0) { fail("query returned no rows for correlation_id " + corr); return }
if (rowCountP) {
  int want = rowCountP.toInteger()
  if (dataRows != want) { fail("query returned " + dataRows + " row(s)"); return }
}
if (columnsP) {
  for (pair in columnsP.split(";")) {
    int eq = pair.indexOf("=")
    if (eq &lt; 0) continue
    def col = pair.substring(0, eq)
    def want = pair.substring(eq + 1)
    def vals = colVals(col)
    if (vals == null) { fail("column " + col + " not in result (columns present: " + header.join(",") + ")"); return }
    boolean okc
    if (want == "__NULL__") {
      okc = vals.any { it == "" || it.equalsIgnoreCase("null") }
    } else {
      def wants = want.split("\\|") as List   // alternation: NAME == A or B  ->  "A|B"
      okc = vals.any { v -&gt; wants.contains(v) }
    }
    if (!okc) { fail("column " + col + " actual " + vals); return }
  }
}
if (!rowCountP &amp;&amp; !columnsP) {
  // fallback proxy (e.g. DB-001 with no column/count EXPECT): a row exists for this correlation_id.
  if (!body.contains(corr)) { fail("no row containing correlation_id " + corr) }
}
            </stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
